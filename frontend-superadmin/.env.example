# ==============================================================================
# Internal API Routing
# ==============================================================================
# [Optional in Dev / Required in Prod/Containers] Internal URL of the backend API service (used for /api/* rewrites)
# Example prod: http://backend-service:4000 or https://api.example.com
BACKEND_INTERNAL_URL=http://127.0.0.1:4000

# ==============================================================================
# Authentication (NextAuth)
# ==============================================================================
# [Required in Production] Canonical URL of the superadmin portal
# Example prod: https://superadmin.example.com
NEXTAUTH_URL=http://localhost:3002

# [Required] Session JWT secret (must match backend NEXTAUTH_SECRET)
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# ==============================================================================
# Cross-Portal Navigation Links (Public)
# ==============================================================================
# [Optional in Dev / Required in Prod] Public URL of customer storefront (used for "Visit Storefront" link & /menu redirects)
# Example prod: https://app.example.com
NEXT_PUBLIC_CUSTOMER_URL=http://localhost:3000

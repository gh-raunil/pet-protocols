# ==============================================================================
# Internal API Routing
# ==============================================================================
# [Optional in Dev / Required in Prod/Containers] Internal URL of the backend API service (used for SSR and /api/* rewrites)
# Example prod: http://backend-service:4000 or https://api.example.com
BACKEND_INTERNAL_URL=http://127.0.0.1:4000

# ==============================================================================
# Authentication (NextAuth)
# ==============================================================================
# [Required in Production] Canonical URL of the customer frontend
# Example prod: https://app.example.com
NEXTAUTH_URL=http://localhost:3000

# [Required] Session JWT secret (must match backend NEXTAUTH_SECRET)
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# ==============================================================================
# Cross-Portal Navigation Links (Public)
# ==============================================================================
# [Optional in Dev / Required in Prod] Public URL of the restaurant admin portal (used for "Partner with us" links & redirects)
# Example prod: https://admin.example.com
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# [Optional in Dev / Required in Prod] Public URL of the superadmin portal (used for staff dashboard redirect)
# Example prod: https://superadmin.example.com
NEXT_PUBLIC_SUPERADMIN_URL=http://localhost:3002

# ==============================================================================
# Payment Gateway (Public Fallback)
# ==============================================================================
# [Optional] Client-side fallback Razorpay Key ID for opening the checkout modal if not returned in order payload
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ==============================================================================
# Web Push Notifications (VAPID)
# ==============================================================================
# [Optional - auto-discovered via /api/push/vapid-public-key if omitted] Public VAPID key for browser push registration
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ==============================================================================
# Mappls Live Delivery Maps (Public)
# ==============================================================================
# [Optional - live interactive map enabled when provided] Browser-restricted public map key for Mappls Web SDK v3.0
# Obtain from https://apis.mappls.com/console/
NEXT_PUBLIC_MAPPLS_MAP_KEY=


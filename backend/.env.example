# ==============================================================================
# Database Configuration
# ==============================================================================
# [Required] MongoDB connection string (Local or MongoDB Atlas)
# Example local: mongodb://127.0.0.1:27017/pet-protocols
# Example prod: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/pet-protocols?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/pet-protocols

# [Optional] Comma-separated list of Atlas shard hosts (used if network cannot resolve SRV records)
MONGODB_HOSTS=

# [Optional] Comma-separated fallback DNS servers for SRV resolution
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ==============================================================================
# Authentication & Security (NextAuth)
# ==============================================================================
# [Required in Production] Canonical URL of the authentication host
NEXTAUTH_URL=http://localhost:3000

# [Required] Strong random secret used to sign and encrypt session JWTs (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# ==============================================================================
# CORS & Allowed Origins (Multi-Tenant Network Boundary)
# ==============================================================================
# [Optional in Dev / Required in Prod] Allowed origin for customer storefront
# Example prod: https://app.example.com
FRONTEND_URL=http://localhost:3000

# [Optional in Dev / Required in Prod] Allowed origin for restaurant admin portal
# Example prod: https://admin.example.com
ADMIN_URL=http://localhost:3001

# [Optional in Dev / Required in Prod] Allowed origin for platform superadmin portal
# Example prod: https://superadmin.example.com
SUPERADMIN_URL=http://localhost:3002

# ==============================================================================
# Google OAuth (Optional)
# ==============================================================================
# [Optional] Google OAuth credentials for customer Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# Payment Gateway (Razorpay)
# ==============================================================================
# [Required for Payments] Razorpay API Key ID and Key Secret from dashboard
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ==============================================================================
# Cloud Storage (Cloudinary)
# ==============================================================================
# [Required in Prod] Cloudinary credentials for restaurant/dish and avatar uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================================================================
# Super Admin Governance & Seeding
# ==============================================================================
# [Required in Prod] Dedicated root Super Admin account email address
SUPERADMIN_EMAIL=superadmin.petprotocols@gmail.com

# [Required when running seed in Prod] Initial password for superadmin account creation during database seed
SUPERADMIN_PASSWORD=

# ==============================================================================
# Platform Support
# ==============================================================================
# [Optional] Platform WhatsApp contact number provided to restaurant admins for platform support
PLATFORM_WHATSAPP_NUMBER=6202377582

# ==============================================================================
# Web Push Notifications (VAPID)
# ==============================================================================
# [Required for Web Push] Public VAPID key shared with client service workers
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=

# [Required for Web Push] Private VAPID key (Keep strictly on backend only!)
VAPID_PRIVATE_KEY=

# [Required for Web Push] Subject contact URI/email for push notification service (e.g. mailto:admin@example.com)
VAPID_SUBJECT=mailto:support@petprotocols.com

# ==============================================================================
# Cron & Scheduled Task Automation
# ==============================================================================
# [Required for Scheduled Messages] Secret authorization token protecting /api/cron/scheduled-messages
# Pass as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-random-cron-secret

# ==============================================================================
# Delivery Handover Verification (OTP)
# ==============================================================================
# [Required in Production] Dedicated 32-byte secret used for keyed HMAC-SHA-256 digests
# and AES-256-GCM authenticated encryption at rest for customer delivery handover OTPs.
# Must be exactly 64 hexadecimal characters (32 bytes).
# Never reuse JWT, session, cron, or database secrets for OTP digests.
# Generate with: openssl rand -hex 32
DELIVERY_OTP_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==============================================================================
# Distributed Rate Limiting & Proxy Configuration
# ==============================================================================
# [Optional in Dev / Configurable in Prod] Rate limiting store backend: 'memory' (default) or 'upstash'
RATE_LIMIT_STORE=memory

# [Required when RATE_LIMIT_STORE=upstash] Upstash Redis REST API URL
# Example: https://us1-clean-slug-12345.upstash.io
UPSTASH_REDIS_REST_URL=

# [Required when RATE_LIMIT_STORE=upstash] Upstash Redis REST API Bearer Token
UPSTASH_REDIS_REST_TOKEN=

# [Deployment Guard] If set to true, backend enforces that RATE_LIMIT_STORE=upstash with valid credentials.
# Prevents silent fallback to in-memory limits in multi-instance or serverless deployments.
RATE_LIMIT_DISTRIBUTED_REQUIRED=false

# [Proxy Security] Set to true ONLY if backend is strictly fronted by Cloudflare or an authoritative edge proxy
# that guarantees overwriting CF-Connecting-IP or X-Real-IP.
RATE_LIMIT_TRUST_EDGE_HEADERS=false

# [Proxy Security] Number of trusted reverse proxy hops between client and backend.
# Set to 1 if behind a single reverse proxy (e.g. NGINX or AWS ALB). Default 0 (direct origin).
RATE_LIMIT_TRUSTED_HOPS=0

# [Proxy Security] Enable trusted proxy evaluation for X-Forwarded-For (default true in non-production).
RATE_LIMIT_TRUST_PROXY=false



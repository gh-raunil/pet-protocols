# ==============================================================================
# Database Configuration
# ==============================================================================
# [Required] MongoDB connection string (Local or MongoDB Atlas)
# Example local: mongodb://127.0.0.1:27017/pet-protocols
# Example prod: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/pet-protocols?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/pet-protocols

# [Optional] Comma-separated list of Atlas shard hosts (used if network cannot resolve SRV records)
MONGODB_HOSTS=

# [Optional] Comma-separated fallback DNS servers for SRV resolution
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ==============================================================================
# Authentication & Security (NextAuth)
# ==============================================================================
# [Required in Production] Canonical URL of the authentication host
NEXTAUTH_URL=http://localhost:3000

# [Required] Strong random secret used to sign and encrypt session JWTs (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# ==============================================================================
# CORS & Allowed Origins (Multi-Tenant Network Boundary)
# ==============================================================================
# [Optional in Dev / Required in Prod] Allowed origin for customer storefront
# Example prod: https://app.example.com
FRONTEND_URL=http://localhost:3000

# [Optional in Dev / Required in Prod] Allowed origin for restaurant admin portal
# Example prod: https://admin.example.com
ADMIN_URL=http://localhost:3001

# [Optional in Dev / Required in Prod] Allowed origin for platform superadmin portal
# Example prod: https://superadmin.example.com
SUPERADMIN_URL=http://localhost:3002

# ==============================================================================
# Google OAuth (Optional)
# ==============================================================================
# [Optional] Google OAuth credentials for customer Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# Payment Gateway (Razorpay)
# ==============================================================================
# [Required for Payments] Razorpay API Key ID and Key Secret from dashboard
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ==============================================================================
# Cloud Storage (Cloudinary)
# ==============================================================================
# [Required in Prod] Cloudinary credentials for restaurant/dish and avatar uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================================================================
# Super Admin Governance & Seeding
# ==============================================================================
# [Required in Prod] Dedicated root Super Admin account email address
SUPERADMIN_EMAIL=superadmin.petprotocols@gmail.com

# [Required when running seed in Prod] Initial password for superadmin account creation during database seed
SUPERADMIN_PASSWORD=

# ==============================================================================
# Platform Support
# ==============================================================================
# [Optional] Platform WhatsApp contact number provided to restaurant admins for platform support
PLATFORM_WHATSAPP_NUMBER=6202377582
